{
  "name": "nfr-ai-pitch",
  "version": "10.0.0",
  "private": true,
  "description": "NFR Workspace v2: client conversation, Workspace demo, layout and quality tests",
  "scripts": {
    "test": "playwright test",
    "test:layout": "playwright test tests/layout.spec.js",
    "serve": "node scripts/serve.js 8080",
    "build:public": "node scripts/build.js public",
    "build:internal": "node scripts/build.js internal",
    "serve:public": "node scripts/build.js public && node scripts/serve.js 8190 dist",
    "serve:internal": "node scripts/build.js internal && node scripts/serve.js 8191 dist-internal",
    "scan:public": "node scripts/build.js scan dist",
    "lint-copy": "python scripts/lint-copy.py",
    "check-emdash": "python scripts/check-emdash.py",
    "build": "pwsh -File scripts/bump-build.ps1",
    "build:dry": "pwsh -File scripts/bump-build.ps1 --DryRun",
    "fallbacks:scenes": "node scripts/build-fallbacks.js 8080",
    "audit:story": "node scripts/audit-story.js",
    "audit:icons": "node scripts/audit-icons.js",
    "audit:motion": "node scripts/audit-motion.js",
    "audit:offline": "node scripts/audit-offline.js",
    "audit:claims": "python scripts/lint-copy.py",
    "audit:all": "node scripts/audit-all.js",
    "qa:visual": "node scripts/visual-qa.js 8080",
    "stamp": "node scripts/stamp-build.js",
    "fallback": "node scripts/export-fallback.js 8080"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
